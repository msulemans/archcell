---
import { isCurrent } from '../lib/nav.js';
import { getSiteSettings, textWithBreaks } from '../lib/content.js';

const path = Astro.url.pathname;
const settings = await getSiteSettings();
const footer = settings.footer ?? {};
const nav = [
  ['/projects/', 'Selected work'],
  ['/studio/', 'The studio'],
  ['/services/', 'Services'],
  ['/process/', 'Our process'],
  ['/drawings/', 'Drawing room'],
  ['/contact/', 'Contact'],
];
---
<footer class="site-footer section-pad">
  <div class="footer-top"><span class="eyebrow">ARCHCELL / LAHORE, PAKISTAN</span><a class="text-link" href="/contact/">Tell us about your project <span>↗</span></a></div>
  <nav class="footer-navigation" aria-label="Footer navigation">
    {nav.map(([href, label]) => <a href={href} aria-current={isCurrent(path, href) ? 'page' : undefined}>{label}</a>)}
  </nav>
  <div class="footer-bottom"><p set:html={textWithBreaks(footer.statement)}></p><a href="#" class="back-top">BACK TO TOP ↑</a></div>
  <div class="footer-fine"><span>{footer.copyright}</span><span>{footer.finePrint}</span><a href="/privacy/">About this preview</a><button id="credits-button">Photography credits ↗</button></div>
</footer>
