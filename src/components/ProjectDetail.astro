---
import { drawingSVG } from '../lib/drawings.js';

const { project, drawings = false, next = project, sheets = [] } = Astro.props;

const catOrder = ['Architecture', 'Elevations', 'Structural', 'Electrical', 'Plumbing', 'Interiors'];
const categories = catOrder.filter((c) => sheets.some((s) => s.category === c));
const category = categories.includes('Architecture') ? 'Architecture' : categories[0] ?? 'All drawings';
const catCount = (c) => (c === 'All drawings' ? sheets.length : sheets.filter((s) => s.category === c).length);
const pairImageA = project.gallery?.[0] ?? `/assets/${project.id === 'warm-minimalism' ? 'facade-detail.jpg' : 'interior.jpg'}`;
const pairImageB = project.gallery?.[1] ?? `/assets/${project.id === 'quiet-courtyard' ? 'residence.jpg' : 'courtyard.jpg'}`;
---
<article>
  <section class="project-hero">
    <img src={project.image} alt={`${project.name} — reference photography`} />
    <div class="project-hero-shade"></div>
    <a class="project-back" href="/projects/#work">← Back to selected work</a>
    <div class="project-hero-title"><p class="eyebrow">{project.type.toUpperCase()} / CONCEPT SHOWCASE</p><h1 tabindex="-1">{project.name}</h1><p>{project.location}<span>·</span>{project.year}</p></div>
    <a href={drawings ? '#project-catalogue' : `/projects/${project.id}/drawings/`} data-page-transition={drawings ? undefined : true} class="project-hero-cta">Explore the drawings <span>↓</span></a>
  </section>
  <nav class="project-subnav" aria-label="Project sections">
    <a href={`/projects/${project.id}/`} data-page-transition>The story</a>
    <a href={`/projects/${project.id}/drawings/`} data-page-transition aria-current={drawings ? 'location' : undefined}>Drawing catalogue <span>{sheets.length}</span></a>
    <span>{project.area} / {project.type}</span>
  </nav>
  <section class="project-story section-pad">
    <div><p class="eyebrow">THE IDEA</p><h2>{project.theme}</h2></div>
    <div>
      <p>{project.description}</p>
      <dl class="project-facts">
        <div><dt>LOCATION</dt><dd>{project.location}</dd></div>
        <div><dt>PLOT SIZE</dt><dd>{project.area}</dd></div>
        <div><dt>MATERIAL PALETTE</dt><dd>{project.materials}</dd></div>
        <div><dt>PROJECT SCOPE</dt><dd>Architecture, interiors & working drawings</dd></div>
      </dl>
      <p class="project-disclaimer">Concept showcase. Project details and photography are illustrative, ready to be replaced with the studio’s completed work.</p>
    </div>
  </section>
  <section class="detail-image-pair">
    <img src={pairImageA} alt="Interior material and atmosphere reference" />
    <div><img src={pairImageB} alt="Architectural light and space reference" loading="lazy" /><span>LIGHT, MATERIAL & THE SPACES BETWEEN.</span></div>
  </section>
  <section id="project-catalogue" class="catalogue section-pad">
    <div class="section-heading"><div><p class="eyebrow">FROM VISION TO DETAIL</p><h2 tabindex="-1">The complete <em>picture.</em></h2></div><div class="catalogue-count"><strong>{sheets.length}</strong><span>DRAWINGS<br>{categories.length} DISCIPLINES</span></div></div>
    <p class="catalogue-intro">Explore each discipline, open a sheet, and look closer. These sample diagrams demonstrate the project library; they are not construction documents.</p>
    <div class="catalogue-filters" aria-label="Filter drawings by discipline">
      {['All drawings', ...categories].map((c) => (
        <button data-category={c} aria-pressed={String(c === category)}>{c}<span>{catCount(c)}</span></button>
      ))}
    </div>
    <div class="sheet-grid" id="sheet-grid" aria-live="polite">
      {sheets.map((s, i) => (
        <button class="sheet-card" data-sheet={i} data-code={s.code} data-name={s.name} data-category={s.category} hidden={s.category !== category}>
          <span class="sheet-image"><Fragment set:html={drawingSVG(s, project)} /><span class="open-sheet">View drawing ↗</span></span>
          <span class="sheet-meta"><span>{s.code}<strong>{s.name}</strong></span><span aria-hidden="true">↗</span></span>
        </button>
      ))}
    </div>
    <p class="catalogue-note">SAMPLE COLLECTION / SVG FORMAT / NOT TO SCALE</p>
  </section>
  <a class="next-project" href={`/projects/${next.id}/`} data-page-transition><img src={next.image} alt={next.name} loading="lazy" /><div><p class="eyebrow">NEXT PROJECT</p><h2>{next.name}</h2></div><span>↗</span></a>
  <div class="detail-footer"><a href="/">ARCHCELL</a><span>LAHORE, PAKISTAN</span><a href="/projects/">ALL PROJECTS ↗</a></div>
</article>
