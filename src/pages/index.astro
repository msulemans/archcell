---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects, getSheets, sheetsForProject, getHomePage, getSiteSettings, textWithBreaks } from '../lib/content.js';
import { drawingSVG } from '../lib/drawings.js';
import { imageUrl } from '../lib/sanity.js';

const projects = await getProjects();
const sheets = await getSheets();
const home = await getHomePage();
const settings = await getSiteSettings();
const hero = home.hero ?? {};
const intro = home.intro ?? {};
const work = home.work ?? {};
const interlude = home.interlude ?? {};
const drawingRoom = home.drawingRoom ?? {};
const studio = home.studio ?? {};
const stats = settings.stats ?? {};
const heroImage = imageUrl(hero.image, 2000) ?? '/assets/residence.jpg';
const interludeImage = imageUrl(interlude.image, 2000) ?? '/assets/interior.jpg';
const studioImage = imageUrl(studio.image, 1400) ?? '/assets/courtyard.jpg';
const teaserSheets = sheetsForProject(sheets, projects[0].id);
const teaserSheet = teaserSheets[0] ?? sheets[0];
const teaserCount = teaserSheets.length || sheets.length;
---
<BaseLayout
  title="Archcell — Spaces for the way you live."
  description="Archcell is a Lahore-based architecture and interior design practice. Explore considered homes, expressive elevations and complete project drawing collections."
>
  <section class="hero" id="home">
    <img class="hero-image" src={heroImage} alt="Sculptural modern residence set in a green landscape" fetchpriority="high" />
    <div class="hero-shade"></div>
    <div class="hero-topline"><span>{hero.toplineLeft}</span><span>{hero.toplineRight}</span></div>
    <div class="hero-content"><p class="eyebrow light">{hero.eyebrow}</p><h1>{hero.titleTop}<br>{hero.titleLine2} <em>{hero.titleEm}</em></h1><div class="hero-bottom"><p set:html={textWithBreaks(hero.paragraph)}></p><a href="#work" class="round-link"><span>Explore our work</span><i>↘</i></a></div></div>
    <div class="hero-footer"><span>{hero.footerLeft}</span><a href={`/projects/${projects[0].id}/`} data-page-transition>FEATURED / {projects[0].name.toUpperCase()} <span>↗</span></a><a href="#work" class="scroll-note">SCROLL TO DISCOVER <span>↓</span></a></div>
  </section>
  <section class="intro section-pad" id="intro"><div class="eyebrow">{intro.eyebrow}</div><div><h2>{intro.heading}<br><span>{intro.headingSpan} <em>{intro.headingEm}</em></span></h2><div class="intro-bottom"><p>{intro.paragraph}</p><a class="text-link" href="/process/">{intro.linkLabel} <span>↗</span></a></div></div></section>
  <section class="work section-pad" id="work">
    <div class="section-heading"><div><p class="eyebrow">{work.eyebrow}</p><h2>{work.heading} <em>{work.headingEm}</em></h2></div><p set:html={textWithBreaks(work.aside)}></p></div>
    <div id="project-grid" class="project-grid">
      {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>
    <div class="work-note"><span>{work.noteLabel}</span><p>{work.noteText}</p></div>
  </section>
  <section class="image-interlude"><img src={interludeImage} alt="Sunlight falling across a considered, warm living space" loading="lazy" /><div class="interlude-shade"></div><div class="reveal"><p class="eyebrow light">{interlude.eyebrow}</p><h2>{interlude.heading}<br><em>{interlude.headingEm}</em></h2></div><span>{interlude.label}</span></section>
  <section class="drawing-room section-pad" id="drawing-room">
    <div class="drawing-copy reveal"><p class="eyebrow">{drawingRoom.eyebrow}</p><h2>{drawingRoom.heading}<br><em>{drawingRoom.headingEm}</em></h2><p>{drawingRoom.paragraph}</p><div class="discipline-tags">{(drawingRoom.teaserLabels ?? []).map((label) => <span>{label}</span>)}</div><a class="text-link" href={`/projects/${projects[0].id}/drawings/`} data-page-transition>{drawingRoom.linkLabel} <span>↗</span></a></div>
    <a class="drawing-teaser reveal" href={`/projects/${projects[0].id}/drawings/`} data-page-transition aria-label={`Open ${projects[0].name} drawing catalogue`}><div class="drawing-teaser-top"><span>ARCHCELL / PROJECT ARCHIVE</span><span>↗</span></div><div id="plan-teaser" set:html={drawingSVG(teaserSheet, projects[0])}></div><div class="drawing-teaser-bottom"><div><span>{projects[0].name.toUpperCase()}</span><strong>Every detail. In one place.</strong></div><span>{teaserCount}<br><small>SHEETS</small></span></div></a>
  </section>
  <section class="studio section-pad" id="studio"><div class="studio-image reveal"><img src={studioImage} alt="A planted courtyard framed by concrete and glass" loading="lazy" /><span>FINDING THE EXTRAORDINARY IN THE EVERYDAY.</span></div><div class="studio-copy reveal"><p class="eyebrow">{studio.eyebrow}</p><h2>{studio.heading}<br><em>{studio.headingEm}</em></h2><p>{studio.paragraphOne}</p><p>{studio.paragraphTwo}</p><div class="studio-stats"><div><strong>{stats.yearsValue}<span>{stats.yearsSuffix}</span></strong><span>{stats.yearsLabel}</span></div><div><strong>{stats.projectsValue}<span>{stats.projectsSuffix}</span></strong><span>{stats.projectsLabel}</span></div></div><div class="studio-services"><span>Architecture</span><span>Interior design</span><span>Complete working drawings</span></div></div></section>
</BaseLayout>
