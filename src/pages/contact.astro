---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteSettings, getFaqs } from '../lib/content.js';

const settings = await getSiteSettings();
const contact = settings.contact ?? {};
const faqs = await getFaqs('contact');
---
<BaseLayout
  title="Start Your Project — Archcell"
  description="Create a demo project enquiry for your home, interiors or working drawings."
  interior
>
  <section class="page-heading contact-heading section-pad"><div class="page-kicker"><span class="eyebrow">START A CONVERSATION</span><span>YOUR NEXT CHAPTER</span></div><h1>It begins with<br><em>your idea.</em></h1><div class="page-heading-bottom"><p>A new home, a room reimagined, a first possibility.<br>Tell us what you have in mind.</p><a href="#project-brief" class="text-link">Write your brief <span>↓</span></a></div></section>
  <section class="contact-layout section-pad">
    <aside class="contact-aside"><div class="contact-photo"><img src="/assets/hero-night.jpg" alt="Warm illuminated entrance to a contemporary home"></div><p class="eyebrow">ARCHCELL / LAHORE</p><h2>Good spaces start<br>with a <em>conversation.</em></h2><dl><div><dt>EMAIL / DEMO</dt><dd>{contact.email}</dd></div><div><dt>WHATSAPP / DEMO</dt><dd>{contact.whatsapp}</dd></div><div><dt>STUDIO</dt><dd>{contact.address}<br><small>{contact.addressNote}</small></dd></div></dl><p class="contact-demo-note">{contact.demoNote}</p><a href="/process/" class="text-link">What happens next <span>↗</span></a></aside>
    <div class="enquiry-panel" id="project-brief">
      <div id="enquiry-form-wrap">
        <div class="enquiry-top"><span class="eyebrow">YOUR PROJECT BRIEF</span><button type="button" id="fill-demo">Try a sample brief ↗</button></div>
        <div class="form-steps" aria-label="Enquiry progress" aria-live="polite"><span class="active" id="step-label-1" aria-current="step"><b>01</b> The project</span><i></i><span id="step-label-2"><b>02</b> About you</span></div>
        <form id="enquiry-form" novalidate>
          <fieldset data-step="1">
            <legend tabindex="-1">What are you imagining?</legend>
            <p class="field-help">Choose the closest fit. Fields marked * are required.</p>
            <div class="service-options">
              <label><input type="radio" name="service" value="Complete home" required><span>Complete home<small>Architecture + interiors + drawings</small></span></label>
              <label><input type="radio" name="service" value="Architecture"><span>Architecture<small>Plans, spaces & elevations</small></span></label>
              <label><input type="radio" name="service" value="Interiors"><span>Interiors<small>Materials, rooms & details</small></span></label>
              <label><input type="radio" name="service" value="Working drawings"><span>Working drawings<small>Technical project documentation</small></span></label>
            </div>
            <div class="form-row">
              <label for="project-location">Project location <span>*</span><input id="project-location" name="location" type="text" maxlength="120" placeholder="e.g. DHA, Lahore" autocomplete="address-level2" required></label>
              <label for="plot-size">Plot / covered area <span class="optional">Optional</span><input id="plot-size" name="area" type="text" maxlength="100" placeholder="e.g. 1 kanal or 2,500 sq ft"></label>
            </div>
            <label class="field-label" for="project-timeline">When would you like to begin?<select id="project-timeline" name="timeline"><option value="Still exploring">Still exploring</option><option value="Within 3 months">Within 3 months</option><option value="In 3–6 months">In 3–6 months</option><option value="Later this year">Later this year</option><option value="Flexible">Flexible</option></select></label>
            <div class="form-actions"><span>STEP 01 OF 02</span><button type="button" class="solid-button" id="next-step">A little about you <span>→</span></button></div>
          </fieldset>
          <fieldset data-step="2" hidden disabled>
            <legend tabindex="-1">Who are we designing for?</legend>
            <p class="field-help">Fields marked * are required. This is a demo enquiry.</p>
            <div class="form-row">
              <label for="client-name">Your name <span>*</span><input id="client-name" name="name" type="text" maxlength="100" placeholder="Full name" autocomplete="name" required></label>
              <label for="client-email">Email address <span>*</span><input id="client-email" name="email" type="email" maxlength="200" placeholder="you@example.com" autocomplete="email" required></label>
            </div>
            <label class="field-label" for="client-phone">Phone / WhatsApp <span class="optional">Optional</span><input id="client-phone" name="phone" type="tel" maxlength="40" placeholder="Include your country code" autocomplete="tel"></label>
            <label class="field-label" for="project-message">A few words about your idea <span>*</span><textarea id="project-message" name="message" aria-describedby="message-help" rows="5" minlength="15" maxlength="3000" placeholder="The rooms you need, how you like to live, or anything you want us to understand…" required></textarea><small id="message-help">At least 15 characters. Please avoid sensitive information.</small></label>
            <label class="demo-consent"><input type="checkbox" name="demoConsent" required><span>I understand this is a demo. My brief will be prepared in this browser and will not be sent to Archcell.</span></label>
            <div class="form-actions"><button type="button" class="back-button" id="previous-step">← The project</button><button type="submit" class="solid-button">Preview my enquiry <span>↗</span></button></div>
          </fieldset>
          <p id="form-error" class="form-error" role="alert"></p>
        </form>
        <p class="form-privacy"><strong>Demo only. No enquiry is sent.</strong> Your entries are not uploaded or stored by this form. <a href="/privacy/">About this preview</a></p>
      </div>
      <section id="enquiry-result" hidden aria-labelledby="enquiry-result-title"><span class="eyebrow">DEMO BRIEF PREPARED</span><h2 id="enquiry-result-title" tabindex="-1">Your project.<br><em>On one page.</em></h2><p class="result-notice">This is a preview. No enquiry has been sent. Download your brief to keep it, or return to make changes.</p><dl id="enquiry-summary"></dl><div class="result-actions"><button class="solid-button" id="download-brief">Download my brief <span>↓</span></button><button class="back-button" id="edit-brief">Edit details</button></div><button class="new-brief" id="new-brief">Start a new brief ↗</button></section>
    </div>
  </section>
  <section class="faq-section section-pad"><div><p class="eyebrow">A FEW FIRST ANSWERS</p><h2>Before<br><em>hello.</em></h2></div><div class="faq-list">{faqs.map((item) => <details><summary>{item.question}<span>+</span></summary><p>{item.answer}</p></details>)}</div></section>
</BaseLayout>
