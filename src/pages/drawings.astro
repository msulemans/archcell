---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects, getSheets } from '../lib/content.js';

const projects = await getProjects();
const sheets = await getSheets();
---
<BaseLayout
  title="The Drawing Room — Archcell"
  description="Browse project collections of plans, elevations, structural, electrical, plumbing and interior drawings."
  interior
>
  <section class="page-heading section-pad"><div class="page-kicker"><span class="eyebrow">THE DRAWING ROOM</span><span>THE ARCHITECTURE BEHIND THE IMAGE</span></div><h1>Every line.<br><em>Part of the story.</em></h1><div class="page-heading-bottom"><p>Plans, elevations and the systems within.<br>A complete collection, organised project by project.</p><div class="catalogue-count"><strong>{projects.length}</strong><span>PROJECTS<br>{sheets.length} SAMPLE SHEETS EACH</span></div></div></section>
  <section class="archive-intro section-pad"><p>Choose a project below to browse its architectural, structural, electrical, plumbing and interior drawing collection.</p><span class="sample-stamp">ILLUSTRATIVE DIAGRAMS<br>NOT FOR CONSTRUCTION</span></section>
  <section class="archive-list section-pad" id="archive-list" aria-label="Project drawing collections">
    {projects.map((p, i) => (
      <a class="archive-row reveal" href={`/projects/${p.id}/drawings/`} data-page-transition>
        <span class="archive-number">{String(i + 1).padStart(2, '0')}</span>
        <img src={`/assets/${p.image}`} alt={`${p.name} — reference image`} loading="lazy" />
        <div><span class="eyebrow">{p.location.toUpperCase()}</span><h2>{p.name}</h2><p>Architecture · Elevations · Structure<br>Electrical · Plumbing · Interiors</p></div>
        <span class="archive-total">{sheets.length}<small>DRAWINGS</small></span>
        <span class="archive-arrow">↗</span>
      </a>
    ))}
  </section>
  <section class="drawing-guide section-pad"><div><p class="eyebrow">TAKE A CLOSER LOOK</p><h2>One project.<br><em>The whole picture.</em></h2></div><ol><li><span>01</span><div><h3>Choose a discipline</h3><p>Move between plans, elevations, structural, electrical, plumbing and interiors.</p></div></li><li><span>02</span><div><h3>Open a drawing</h3><p>View a sheet at full size, zoom into details, and move to the next drawing.</p></div></li><li><span>03</span><div><h3>Keep a reference</h3><p>Download an illustrative SVG sheet for a closer look. Sample diagrams are not construction documents.</p></div></li></ol></section>
</BaseLayout>
