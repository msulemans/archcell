---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, getProjectTypes } from '../../lib/content.js';

const projects = await getProjects();
const types = await getProjectTypes();
const count = (type) => String(type === 'All' ? projects.length : projects.filter((p) => p.type === type).length).padStart(2, '0');
---
<BaseLayout
  title="The Project Collection — Archcell"
  description="Explore Archcell’s illustrative portfolio of residential architecture and interiors."
  interior
>
  <section class="page-heading section-pad"><div class="page-kicker"><span class="eyebrow">THE PROJECT COLLECTION</span><span>06 / SELECTED CONCEPTS</span></div><h1>Different lives.<br><em>Distinctive spaces.</em></h1><div class="page-heading-bottom"><p>A collection of architectural possibilities.<br>Open a project to explore its story and drawings.</p><span class="sample-stamp">CONCEPT SHOWCASE<br>REFERENCE PHOTOGRAPHY</span></div></section>
  <section class="portfolio-index section-pad" id="work">
    <div class="portfolio-filters" aria-label="Filter projects">
      <button aria-pressed="true" data-project-filter="All">All projects <span>{count('All')}</span></button>
      {types.map((type) => <button aria-pressed="false" data-project-filter={type}>{type} <span>{count(type)}</span></button>)}
      <span id="project-count" role="status">{projects.length} project{projects.length === 1 ? '' : 's'}</span>
    </div>
    <div id="project-grid" class="project-grid">
      {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>
    <div class="work-note"><span>ILLUSTRATIVE PORTFOLIO</span><p>Sample details and reference photos, ready for Archcell’s real project collection.</p></div>
  </section>
</BaseLayout>
