---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectDetail from '../../../components/ProjectDetail.astro';
import { getProjects, getSheets, sheetsForProject, getNextProjectFrom } from '../../../lib/content.js';

export async function getStaticPaths() {
  const projects = await getProjects();
  const allSheets = await getSheets();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, next: getNextProjectFrom(projects, project), sheets: sheetsForProject(allSheets, project.id) },
  }));
}

const { project, next, sheets } = Astro.props;
---
<BaseLayout
  title={`${project.name} — Archcell`}
  description={`${project.description} A concept showcase in ${project.location}.`}
  interior
  bodyClass="project-open"
  projectSlug={project.id}
  projectName={project.name}
>
  <ProjectDetail project={project} next={next} sheets={sheets} />
</BaseLayout>
